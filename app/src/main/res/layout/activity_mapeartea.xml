<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="24dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txt_mensagem6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Nesta aba faremos algumas breves perguntas para saber mais sobre você e te atender melhor."
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>

            <!-- GRID DE AVATARES -->
            <GridLayout
                android:id="@+id/grid_avatares"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:columnCount="2"
                android:rowCount="3"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:id="@+id/txt_mensagem7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Insira o seu nível de TEA de 1 a 3:"
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edt_nivel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nível:"
                android:textColorHint="@color/cardview_dark_background"
                android:inputType="text"
                android:textSize="16sp"
                android:layout_marginBottom="24dp"/>

            <!-- BOTÃO FINAL -->
            <Button
                android:id="@+id/btn_confirma_mt"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Confirmar"
                android:textColor="@color/lume_texto"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>