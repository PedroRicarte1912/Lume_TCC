<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Complete as palavras"
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Digite as letras que faltam em cada palavra."
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <!-- LUA: _UA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgLua"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/lua"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="_UA"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtLua"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- FOGO: F_GO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgFogo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/fogo"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="F_GO"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtFogo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- ESCOLA: ESC_LA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgEscola"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/escola"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="ESC_LA"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtEscola"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- PORTA: P_RTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgPorta"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/porta"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="P_RTA"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtPorta"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- CAMA: CA_A -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgCama"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/cama"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="CA_A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtCama"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- GATO: GA_O -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/imgGato"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/gato"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="GA_O"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtGato"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnVerificarCompletar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Verificar"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>