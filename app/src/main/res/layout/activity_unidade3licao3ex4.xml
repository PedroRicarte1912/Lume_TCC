<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="24dp"
            android:elevation="8dp">

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ligue a imagem à palavra"
                android:textColor="@color/lume_texto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- INSTRUÇÃO -->
            <TextView
                android:id="@+id/txtInstrucao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toque em uma imagem e depois na palavra correspondente."
                android:textColor="#666666"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"/>

            <!-- SOPA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgSopa"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:padding="8dp"
                    android:src="@drawable/sopa"
                    android:tag="sopa"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvCachorro"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:text="Cachorro"
                    android:textColor="@color/lume_texto"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:tag="cachorro"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@color/lume_rosa"/>

            </LinearLayout>

            <!-- JANELA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgJanela"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:padding="8dp"
                    android:src="@drawable/janela"
                    android:tag="janela"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvLeite"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:text="Leite"
                    android:textColor="@color/lume_texto"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:tag="leite"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@color/lume_lilas"/>

            </LinearLayout>

            <!-- LEITE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgLeite"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:padding="8dp"
                    android:src="@drawable/leite"
                    android:tag="leite"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvSopa"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:text="Sopa"
                    android:textColor="@color/lume_texto"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:tag="sopa"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@color/lume_azul"/>

            </LinearLayout>

            <!-- CACHORRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgCachorro"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:padding="8dp"
                    android:src="@drawable/cachorro"
                    android:tag="cachorro"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvDinheiro"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:text="Dinheiro"
                    android:textColor="@color/lume_texto"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:tag="dinheiro"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@color/lume_verde"/>

            </LinearLayout>

            <!-- DINHEIRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/imgDinheiro"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:padding="8dp"
                    android:src="@drawable/dinheiro"
                    android:tag="dinheiro"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvJanela"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:text="Janela"
                    android:textColor="@color/lume_texto"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:tag="janela"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@color/lume_amarelo"/>

            </LinearLayout>

            <!-- BOTÃO FINAL -->
            <Button
                android:id="@+id/btnEntregar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Entregar Resposta"
                android:textColor="@color/lume_texto"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>