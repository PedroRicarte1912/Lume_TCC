<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lume_lilas">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:background="@color/lume_branco_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/logo_desc"
            android:scaleType="centerInside"
            android:src="@drawable/logo_lume" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:text="@string/bem_vindo"
            android:textColor="@color/lume_texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_EmailLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="#FFDBE8FF"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/lume_texto"
            android:textColorHint="#99B0D0" />

        <!-- Campo de senha substituído pelo TextInputLayout -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/senhaInputLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/lume_texto"
            app:boxBackgroundColor="#FFDBE8FF"
            app:hintTextColor="@color/lume_texto"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_SenhaLogin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Senha"
                android:inputType="textPassword"
                android:textColor="@color/lume_texto"
                android:textColorHint="#99B0D0" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_login2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/lume_rosa"
            android:text="Fazer Login"
            android:textColor="@color/lume_texto"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/btn_recuperaSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Esqueceu a senha? Recupere"
            android:textSize="16sp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>