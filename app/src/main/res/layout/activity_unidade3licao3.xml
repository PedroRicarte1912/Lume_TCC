<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txtExplicacao31"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Escute os áudios e, em seguida, digite o que ouviu."
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <!-- BOLO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgBolo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/bolo"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnBolo"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_rosa"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtBolo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- CAMA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgCama"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/cama"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnCama"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_lilas"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtCama"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- CASA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgCasa"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/casa"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnCasa"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_azul"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtCasa"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- MESA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/imgMesa"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/mesa"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnMesa"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_verde"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtMesa"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnVerificar333"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Próximo Exercício"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>