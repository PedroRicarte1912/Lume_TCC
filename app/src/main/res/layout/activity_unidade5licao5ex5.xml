<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txtExplicacaoU5L5EX5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:text="Observe a imagem, leia a frase e escreva-a no campo abaixo."
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ITEM 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgMaca"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/maca"
                        android:scaleType="fitCenter"/>

                    <TextView
                        android:id="@+id/txtFrase1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="A menina comeu uma maçã madura."
                        android:textColor="@color/lume_texto"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <EditText
                    android:id="@+id/edtFrase1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFDBE8FF"
                    android:hint="Escreva a frase"
                    android:inputType="textMultiLine"
                    android:minLines="1"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- ITEM 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgCarro"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/carro"
                        android:scaleType="fitCenter"/>

                    <TextView
                        android:id="@+id/txtFrase2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="O carro do papai é muito rápido."
                        android:textColor="@color/lume_texto"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <EditText
                    android:id="@+id/edtFrase2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFDBE8FF"
                    android:hint="Escreva a frase"
                    android:inputType="textMultiLine"
                    android:minLines="1"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- ITEM 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgLivro"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/livro"
                        android:scaleType="fitCenter"/>

                    <TextView
                        android:id="@+id/txtFrase3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Eu gosto de ler livros na escola."
                        android:textColor="@color/lume_texto"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <EditText
                    android:id="@+id/edtFrase3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFDBE8FF"
                    android:hint="Escreva a frase"
                    android:inputType="textMultiLine"
                    android:minLines="1"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnProximoU5L5EX5"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Próximo Exercício"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>