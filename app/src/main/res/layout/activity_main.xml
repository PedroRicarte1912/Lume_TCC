<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lume_amarelo">

    <ImageView
        android:id="@+id/logo2"
        android:layout_width="200dp"
        android:layout_height="160dp"
        android:contentDescription="@string/logo_desc"
        android:scaleType="centerInside"
        android:src="@drawable/logo_lume"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_bemvindo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bem-vindo ao Lume!"
        android:textAlignment="center"
        android:textColor="@color/lume_texto"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo2" />

    <TextView
        android:id="@+id/txt_mensagem1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Vamos começar seu dia!"
        android:textAlignment="center"
        android:textColor="@color/lume_texto"
        android:textSize="16sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_bemvindo"
        app:layout_constraintBottom_toTopOf="@id/btn_testesensorial" />

    <Button
        android:id="@+id/btn_testesensorial"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="14dp"
        android:backgroundTint="@color/lume_rosa"
        android:text="Teste Sensorial"
        android:textColor="@color/lume_texto"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:icon="@drawable/brain"
        app:iconGravity="start"
        app:iconSize="28dp"
        app:iconTint="@color/lume_texto"
        app:layout_constraintBottom_toTopOf="@id/btn_testetea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_mensagem1"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/btn_testetea"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="14dp"
        android:backgroundTint="@color/lume_lilas"
        android:text="Mapear TEA"
        android:textColor="@color/lume_texto"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:icon="@drawable/play"
        app:iconGravity="start"
        app:iconSize="28dp"
        app:iconTint="@color/lume_texto"
        app:layout_constraintBottom_toTopOf="@id/btn_avatar2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_testesensorial" />

    <Button
        android:id="@+id/btn_avatar2"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="14dp"
        android:backgroundTint="@color/lume_azul"
        android:text="Definir Avatar"
        android:textColor="@color/lume_texto"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:icon="@drawable/user"
        app:iconGravity="start"
        app:iconSize="28dp"
        app:iconTint="@color/lume_texto"
        app:layout_constraintBottom_toTopOf="@id/btn_lichoes2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_testetea" />

    <Button
        android:id="@+id/btn_lichoes2"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/lume_verde"
        android:text="Lições"
        android:textColor="@color/lume_texto"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:icon="@drawable/notes"
        app:iconGravity="start"
        app:iconSize="28dp"
        app:iconTint="@color/lume_texto"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_avatar2" />

</androidx.constraintlayout.widget.ConstraintLayout>