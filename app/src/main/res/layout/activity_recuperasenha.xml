<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lume_lilas">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:background="@color/lume_branco_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Ícone de email -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:contentDescription="Ícone de email"
            android:src="@drawable/logo_lume" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"
            android:text="Recuperar Senha"
            android:textColor="@color/lume_texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtítulo / instrução -->
        <TextView
            android:id="@+id/txt_avisoSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Insira seu email cadastrado e enviaremos um link para redefinir sua senha."
            android:textAlignment="center"
            android:textColor="#99B0D0"
            android:textSize="13sp" />

        <!-- Campo de email -->
        <EditText
            android:id="@+id/edt_insiraCodigo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="#FFDBE8FF"
            android:hint="Email cadastrado"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/lume_texto"
            android:textColorHint="#99B0D0" />

        <!-- Botão enviar -->
        <Button
            android:id="@+id/btn_recSenha"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/lume_rosa"
            android:text="Enviar Email"
            android:textColor="@color/lume_texto"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>