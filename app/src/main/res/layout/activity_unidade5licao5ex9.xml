<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txtExplicacaoU5L5EX9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Encontre o erro na frase e reescreva-a corretamente."
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ITEM 1 (fácil) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Frase com erro:"
                    android:textColor="@color/lume_texto"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtFraseErradaU5L5EX9_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="#FFFFE0E0"
                    android:text="A menina bonito chegou."
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/edtRespostaU5L5EX9_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="#FFDBE8FF"
                    android:padding="10dp"
                    android:hint="Digite a frase corrigida"
                    android:inputType="textCapSentences"
                    android:textColor="@color/lume_texto"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- ITEM 2 (médio) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Frase com erro:"
                    android:textColor="@color/lume_texto"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtFraseErradaU5L5EX9_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="#FFFFE0E0"
                    android:text="Nós vai à praia no sábado."
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/edtRespostaU5L5EX9_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="#FFDBE8FF"
                    android:padding="10dp"
                    android:hint="Digite a frase corrigida"
                    android:inputType="textCapSentences"
                    android:textColor="@color/lume_texto"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- ITEM 3 (difícil) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Frase com erro:"
                    android:textColor="@color/lume_texto"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtFraseErradaU5L5EX9_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="#FFFFE0E0"
                    android:text="Ele fazem os deveres de casa todos os dias."
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/edtRespostaU5L5EX9_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="#FFDBE8FF"
                    android:padding="10dp"
                    android:hint="Digite a frase corrigida"
                    android:inputType="textCapSentences"
                    android:textColor="@color/lume_texto"
                    android:textSize="15sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnProximoU5L5EX9"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Próximo Exercício"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>