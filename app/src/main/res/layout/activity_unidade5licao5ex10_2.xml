<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txtExplicacaoU5L5EX10_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:gravity="center"
                android:text="Escolha a pontuação certa para terminar cada frase."
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ITEM 1 (médio) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFraseSemPontuacao1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="#FFDBE8FF"
                    android:text="Que susto você me deu"
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:layout_marginBottom="22dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <Button
                        android:id="@+id/btnPonto1"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="."
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <Button
                        android:id="@+id/btnExclamacao1"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="!"
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <Button
                        android:id="@+id/btnInterrogacao1"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="?"
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ITEM 2 (médio) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFraseSemPontuacao2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="#FFDBE8FF"
                    android:text="Onde você guardou as chaves do carro"
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:layout_marginBottom="22dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <Button
                        android:id="@+id/btnPonto2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="."
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <Button
                        android:id="@+id/btnExclamacao2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="!"
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <Button
                        android:id="@+id/btnInterrogacao2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="?"
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ITEM 3 (difícil) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFraseSemPontuacao3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="#FFDBE8FF"
                    android:text="Depois de muito esforço, ele finalmente conseguiu terminar o projeto"
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:layout_marginBottom="22dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <Button
                        android:id="@+id/btnPonto3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="."
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <Button
                        android:id="@+id/btnExclamacao3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="!"
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <Button
                        android:id="@+id/btnInterrogacao3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/lume_azul"
                        android:text="?"
                        android:textColor="@color/lume_texto"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnProximoU5L5EX10_2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Próximo Exercício"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>