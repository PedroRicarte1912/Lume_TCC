<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayout11"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="24dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txt_texto1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Essa aba explica a função do botão &quot;parar lições&quot;."
                android:textColor="@color/lume_texto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/txt_texto2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Os botões de parar as lições serão como o padrão abaixo:"
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:layout_marginBottom="24dp"/>

            <!-- BOTÃO STOP DE EXEMPLO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stoplicao2"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/lume_rosa"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/img_stop"
                app:iconGravity="textStart"
                app:iconSize="32dp"
                app:iconTint="@color/lume_lilas"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/txt_texto3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Sempre que clicar nesses botões a lição será interrompida e você voltará à tela lições."
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:layout_marginBottom="32dp"/>

            <!-- BOTÃO FINAL -->
            <Button
                android:id="@+id/btn_voltarLicoes"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Voltar à tela lições"
                android:textColor="@color/lume_texto"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>