<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <Button
        android:id="@+id/btn_aboutlicoes"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:backgroundTint="@color/lume_verde"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="32dp"
        app:icon="@drawable/img_about"
        app:iconGravity="textStart"
        app:iconSize="32dp"
        app:iconTint="@color/lume_lilas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp"/>

    <Button
        android:id="@+id/btn_stoplicoes"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:backgroundTint="@color/lume_rosa"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="32dp"
        app:icon="@drawable/img_stop"
        app:iconGravity="textStart"
        app:iconSize="32dp"
        app:iconTint="@color/lume_lilas"
        app:layout_constraintStart_toEndOf="@id/btn_aboutlicoes"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/btn_aboutlicoes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txtExplicacaoU5L5EX7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Complete a frase com a palavra que falta."
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ITEM 1 (fácil) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFrase1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O sapo ______ no rio."
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtLacuna1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFDBE8FF"
                    android:hint="Palavra que falta"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0" />

            </LinearLayout>

            <!-- ITEM 2 (médio) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFrase2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O cachorro da vizinha ______ muito de noite."
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtLacuna2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFDBE8FF"
                    android:hint="Palavra que falta"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0" />

            </LinearLayout>

            <!-- ITEM 3 (médio) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFrase3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Todos os dias eu tomo leite com ______."
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtLacuna3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFDBE8FF"
                    android:hint="Palavra que falta"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0" />

            </LinearLayout>

            <!-- ITEM 4 (difícil) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFrase4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O atleta treinou bastante durante todo o ano e finalmente conseguiu ganhar a medalha de ______ na competição."
                    android:textColor="@color/lume_texto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtLacuna4"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFDBE8FF"
                    android:hint="Palavra que falta"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0" />

            </LinearLayout>

            <Button
                android:id="@+id/btnProximoU5L5EX7"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Próximo Exercício"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>