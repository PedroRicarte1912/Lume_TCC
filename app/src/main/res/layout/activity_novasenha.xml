<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lume_lilas">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:background="@color/lume_branco_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Ícone de cadeado no lugar do logo -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:contentDescription="Ícone de senha"
            android:src="@drawable/logo_lume" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"
            android:text="Nova Senha"
            android:textColor="@color/lume_texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:text="Escolha uma senha segura para sua conta"
            android:textAlignment="center"
            android:textColor="#99B0D0"
            android:textSize="13sp" />

        <!-- Campo nova senha -->
        <EditText
            android:id="@+id/edt_novaSenha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="#FFDBE8FF"
            android:hint="Nova senha"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/lume_texto"
            android:textColorHint="#99B0D0" />

        <!-- Campo confirmar senha -->
        <EditText
            android:id="@+id/edt_confirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="#FFDBE8FF"
            android:hint="Confirmar nova senha"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/lume_texto"
            android:textColorHint="#99B0D0" />

        <!-- Botão salvar -->
        <Button
            android:id="@+id/btn_salvar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/lume_rosa"
            android:text="Salvar Senha"
            android:textColor="@color/lume_texto"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

        <!-- Texto de avisos/feedback -->
        <TextView
            android:id="@+id/txt_avisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text=""
            android:textSize="13sp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>