<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayout4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="24dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txt_explicacao1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Cada lição é composta por exercícios variados."
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txt_explicacao2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Clique nos botões para escutar o som de cada vogal:"
                android:textColor="@color/lume_texto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>

            <!-- BOTÕES DAS VOGAIS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_audioA"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/lume_rosa"
                    android:text="Letra A"
                    android:textColor="@color/lume_texto"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"/>

                <Button
                    android:id="@+id/btn_audioE"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/lume_lilas"
                    android:text="Letra E"
                    android:textColor="@color/lume_texto"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_audioI"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/lume_azul"
                    android:text="Letra I"
                    android:textColor="@color/lume_texto"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"/>

                <Button
                    android:id="@+id/btn_audioO"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/lume_verde"
                    android:text="Letra O"
                    android:textColor="@color/lume_texto"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btn_audioU"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/lume_amarelo"
                    android:text="Letra U"
                    android:textColor="@color/lume_texto"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"/>

            </LinearLayout>

            <!-- BOTÃO FINAL -->
            <Button
                android:id="@+id/btn_proxlicao1"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Próximo Exercício"
                android:textColor="@color/lume_texto"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>