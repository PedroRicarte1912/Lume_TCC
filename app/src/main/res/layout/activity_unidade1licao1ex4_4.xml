<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <Button
        android:id="@+id/btn_aboutlicoes"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:backgroundTint="@color/lume_verde"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="32dp"
        app:icon="@drawable/img_about"
        app:iconGravity="textStart"
        app:iconSize="32dp"
        app:iconTint="@color/lume_lilas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp"/>

    <Button
        android:id="@+id/btn_stoplicoes"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:backgroundTint="@color/lume_rosa"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="32dp"
        app:icon="@drawable/img_stop"
        app:iconGravity="textStart"
        app:iconSize="32dp"
        app:iconTint="@color/lume_lilas"
        app:layout_constraintStart_toEndOf="@id/btn_aboutlicoes"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/btn_aboutlicoes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="24dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txt_explicacao12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Etapa 4 do exercício 1:"
                android:textColor="@color/lume_texto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txt_explicacao13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Escute os áudios e escreva os hiatos:"
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txt_explicacao14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Hiato: duas vogais juntas em sílabas diferentes."
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btn_hiatoAE"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/lume_rosa"
                    app:icon="@drawable/play"
                    app:iconSize="28dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="16dp"/>
                <EditText
                    android:id="@+id/edt_hiatoAE"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="#FFDBE8FF"
                    android:hint="Insira o hiato:"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btn_hiatoAI"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/lume_lilas"
                    app:icon="@drawable/play"
                    app:iconSize="28dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="16dp"/>
                <EditText
                    android:id="@+id/edt_hiatoAI"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="#FFDBE8FF"
                    android:hint="Insira o hiato:"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btn_hiatoOE"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/lume_azul"
                    app:icon="@drawable/play"
                    app:iconSize="28dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="16dp"/>
                <EditText
                    android:id="@+id/edt_hiatoOE"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="#FFDBE8FF"
                    android:hint="Insira o hiato:"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btn_hiatoUA"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/lume_verde"
                    app:icon="@drawable/play"
                    app:iconSize="28dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="16dp"/>
                <EditText
                    android:id="@+id/edt_hiatoUA"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="#FFDBE8FF"
                    android:hint="Insira o hiato:"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <Button
                    android:id="@+id/btn_hiatoIE"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/lume_amarelo"
                    app:icon="@drawable/play"
                    app:iconSize="28dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="16dp"/>
                <EditText
                    android:id="@+id/edt_hiatoIE"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="#FFDBE8FF"
                    android:hint="Insira o hiato:"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_proxunidade1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Ir para Unidade 2"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>