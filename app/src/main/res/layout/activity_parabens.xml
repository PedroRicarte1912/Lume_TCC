<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <!-- BOTÕES TOPO -->
    <Button
        android:id="@+id/btn_about_parabens"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/lume_verde"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="28dp"
        app:icon="@drawable/img_about"
        app:iconGravity="textStart"
        app:iconSize="28dp"
        app:iconTint="@color/lume_lilas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp"/>

    <Button
        android:id="@+id/btn_stop_parabens"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/lume_rosa"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="28dp"
        app:icon="@drawable/img_stop"
        app:iconGravity="textStart"
        app:iconSize="28dp"
        app:iconTint="@color/lume_lilas"
        app:layout_constraintStart_toEndOf="@id/btn_about_parabens"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"/>

    <!-- CABEÇALHO: TÍTULO/SUBTÍTULO + GIF AO LADO, FORA DO CARD -->

    <!-- GIF DO PERSONAGEM, SOLTO NA TELA, SEM CÍRCULO -->
    <ImageView
        android:id="@+id/img_personagem_gif"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_about_parabens"/>

    <TextView
        android:id="@+id/txt_parabens_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="Parabéns! 🎉"
        android:textColor="@color/lume_texto"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/img_personagem_gif"
        app:layout_constraintTop_toTopOf="@id/img_personagem_gif"
        app:layout_constraintBottom_toTopOf="@id/txt_parabens_subtitulo"
        app:layout_constraintVertical_chainStyle="packed"/>

    <TextView
        android:id="@+id/txt_parabens_subtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="Você concluiu a Unidade 1!"
        android:textColor="@color/lume_texto"
        android:textSize="15sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/img_personagem_gif"
        app:layout_constraintTop_toBottomOf="@id/txt_parabens_titulo"
        app:layout_constraintBottom_toBottomOf="@id/img_personagem_gif"/>

    <!-- Garante que o card comece abaixo do que for mais baixo: texto ou GIF -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="img_personagem_gif,txt_parabens_subtitulo"/>

    <!-- CONTEÚDO PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="24dp"
            android:elevation="8dp">

            <!-- BARRA DE PROGRESSO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Progresso total"
                    android:textColor="@color/lume_texto"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/txt_porcentagem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20%"
                    android:textColor="@color/lume_verde"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_unidades"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="20"
                android:progressDrawable="@drawable/bg_progress_verde"
                android:layout_marginBottom="20dp"/>

            <!-- INDICADORES DE UNIDADE (5 círculos) -->
            <LinearLayout
                android:id="@+id/ll_unidades"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/dot_unidade1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_dot_verde"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/dot_unidade2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/lume_texto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_dot_cinza"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/dot_unidade3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/lume_texto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_dot_cinza"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/dot_unidade4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/lume_texto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_dot_cinza"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/dot_unidade5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/lume_texto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_dot_cinza"/>

            </LinearLayout>

            <!-- MENSAGEM MOTIVACIONAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_motivacional"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Você está indo muito bem! 🌟"
                    android:textColor="@color/lume_lilas"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txt_motivacional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Continue assim para dominar todos os sons do português!"
                    android:textColor="@color/lume_texto"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- BOTÃO PRÓXIMA UNIDADE -->
            <Button
                android:id="@+id/btn_proxima_unidade"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Próxima unidade"
                android:textColor="@color/lume_texto"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"
                app:cornerRadius="18dp"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/lume_texto"/>

            <!-- BOTÃO REFAZER -->
            <Button
                android:id="@+id/btn_refazer_unidade"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@android:color/transparent"
                android:text="Refazer esta unidade"
                android:textColor="@color/lume_texto"
                app:strokeColor="#DDDDDD"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeWidth="1.5dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>