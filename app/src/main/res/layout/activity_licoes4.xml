<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutlicoes4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_aboutlicoes4"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="@color/lume_verde"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/img_about"
                    app:iconGravity="textStart"
                    app:iconSize="32dp"
                    app:iconTint="@color/lume_lilas"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_margin="16dp"/>

                <Button
                    android:id="@+id/btn_stoplicoes4"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="@color/lume_rosa"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/img_stop"
                    app:iconGravity="textStart"
                    app:iconSize="32dp"
                    app:iconTint="@color/lume_lilas"
                    app:layout_constraintStart_toEndOf="@id/btn_aboutlicoes"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="12dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtMensagemL4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Essa é a Lição 4: Palavras do Cotidiano!"
                android:textAlignment="center"
                android:textColor="@color/lume_texto"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtDescricaoL4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nesta lição você aprenderá palavras maiores e úteis para sua rotina!"
                android:textAlignment="center"
                android:textColor="#4A90E2"
                android:textSize="18sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtProgressoL4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lições concluídas: 0 / 3"
                android:textColor="@color/lume_texto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="24dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <Button
                    android:id="@+id/btn_U4L4E1"
                    android:layout_width="85dp"
                    android:layout_height="80dp"
                    android:backgroundTint="@color/lume_azul"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="0dp"
                    app:cornerRadius="30dp"
                    app:icon="@drawable/img_star"
                    app:iconSize="36dp"
                    app:iconTint="#000000" />

                <Button
                    android:id="@+id/btn_U4L4E2"
                    android:layout_width="85dp"
                    android:layout_height="80dp"
                    android:backgroundTint="@color/lume_lilas"
                    android:layout_gravity="end"
                    android:layout_marginEnd="30dp"
                    android:layout_marginTop="100dp"
                    app:cornerRadius="30dp"
                    app:icon="@drawable/img_star"
                    app:iconSize="36dp"
                    app:iconTint="#000000" />

                <Button
                    android:id="@+id/btn_U4L4E3"
                    android:layout_width="85dp"
                    android:layout_height="80dp"
                    android:backgroundTint="@color/lume_rosa"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="200dp"
                    app:cornerRadius="30dp"
                    app:icon="@drawable/img_star"
                    app:iconSize="36dp"
                    app:iconTint="#000000" />

            </FrameLayout>

            <Button
                android:id="@+id/btn_proximaUnidade4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/lume_azul"
                android:text="Pular para a próxima unidade"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>