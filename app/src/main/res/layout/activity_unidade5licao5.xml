<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Complete as palavras"
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Digite as letras que faltam em cada palavra."
                android:textColor="@color/lume_texto"
                android:textSize="14sp" />

            <!-- SAPO: S_PO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/imgSapo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/sapo"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="S_PO"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtSapo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- LIVRO: LI_RO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/imgLivro"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/livro"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="LI_RO"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtLivro"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- CHUVA: CH_VA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/imgChuva"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/chuva"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="CH_VA"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtChuva"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- CACHORRO: CACHO_RO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/imgCachorro"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/cachorro"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="CACHO_RO"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtCachorro"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- ELEFANTE: ELE_ANTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/imgElefante"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/elefante"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="ELE_ANTE"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtElefante"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- BORBOLETA: BORBOLE_A -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:id="@+id/imgBorboleta"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/borboleta"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="BORBOLE_A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/lume_texto"
                    android:gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtBorboleta"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="letra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="1"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnVerificarCompletar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Verificar"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>