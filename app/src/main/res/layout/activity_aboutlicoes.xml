<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayout3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="24dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txt_mensagem11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text='A aba "lições" é a aba de ensino propriamente dita, dividida em unidades com números pré-definidos de lições, para ajudar ao usuário em sua alfabetização.'
                android:textAlignment="center"
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/txt_mensagem12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unidade 1: Sons e Letras. Lições de 1 a 3 ensinam sobre as vogais (A, E, I, O, U)."
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:background="@color/lume_rosa"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txt_mensagem13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unidade 2: Alfabeto Completo e Acentuações. Criado para introduzir a Unidade 3."
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:background="@color/lume_lilas"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txt_mensagem14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unidade 3: Sílabas e Introdução à Palavras. Lições de 1 a 5 ensinam sobre as sílabas em palavras curtas."
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:background="@color/lume_azul"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txt_mensagem15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unidade 4: Palavras. Lições de 1 a 3 ensinam sobre palavras maiores."
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:background="@color/lume_verde"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txt_mensagem16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unidade 5: Frases Curtas. Lições de 1 a 10 ensinam sobre frases."
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:background="@color/lume_amarelo"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btn_voltalicoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/lume_verde"
                android:text="Voltar para as Lições"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>