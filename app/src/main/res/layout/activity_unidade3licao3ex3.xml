<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degrade">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txtExplicacao44"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Escute os áudios e, em seguida, digite o que ouviu."
                android:textColor="@color/lume_texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <!-- CARRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgCarro"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/carro"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnCarro"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_rosa"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtCarro"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- NOITE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgNoite"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/noite"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnNoite"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_lilas"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtNoite"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- CHAVE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgChave"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/chave"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnChave"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_azul"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtChave"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- ROUPA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgRoupa"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/roupa"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnRoupa"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_verde"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtRoupa"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- ARROZ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgArroz"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/arroz"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnArroz"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_amarelo"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtArroz"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- ÔNIBUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgOnibus"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/onibus"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnOnibus"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_rosa"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtOnibus"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <!-- TRABALHO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/imgTrabalho"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/trabalho"
                    android:scaleType="fitCenter"/>

                <Button
                    android:id="@+id/btnTrabalho"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/lume_lilas"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="10dp"
                    app:icon="@drawable/play"
                    app:iconSize="24dp"
                    app:iconTint="@color/lume_texto"
                    app:cornerRadius="14dp"/>

                <EditText
                    android:id="@+id/edtTrabalho"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="#FFDBE8FF"
                    android:hint="Digite a palavra"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/lume_texto"
                    android:textColorHint="#99B0D0"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnVerificar333"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/lume_verde"
                android:text="Próximo Exercício"
                android:textColor="@color/lume_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>